---
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import SearchModal from '@/components/SearchModal.astro';
import '@/styles/global.css';
// Fonts ship with the build (npm: @fontsource-variable/*): Vite copies the
// files into /_astro with hashed, base-path-aware URLs.
import sansUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import displayUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import geistMonoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Preload the mono font (pages that show code). Elsewhere it loads on demand. */
  preloadMono?: boolean;
}

const {
  title = 'Daily Updates',
  description = "A chronological record of Meetifyy's development, technical improvements, fixes, and engineering progress.",
  preloadMono = false
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://meetifyy.github.io');
---

<!doctype html>
<html lang="en" data-base={baseUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Daily Updates" />

    <!--
      Background image: preloaded at high priority, one size per breakpoint.
      The `media` attributes mirror the breakpoint in the inline style below so
      each device downloads only the file it will actually paint.
    -->
    <link
      rel="preload"
      href={`${baseUrl}/assets/site-bg-2560.webp`}
      as="image"
      type="image/webp"
      media="(min-width: 769px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href={`${baseUrl}/assets/site-bg-1600.webp`}
      as="image"
      type="image/webp"
      media="(max-width: 768px)"
      fetchpriority="high"
    />

    <!-- Fonts: preloaded so they are normally ready before first paint. -->
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Mono is used only in code blocks (update pages, 404). Elsewhere it is
         fetched at idle priority so a later navigation still finds it cached. -->
    {preloadMono
      ? <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin="anonymous" />
      : <link rel="prefetch" href={geistMonoUrl} as="font" type="font/woff2" crossorigin="anonymous" />}

    <!--
      Critical styles, inlined so they apply on the very first frame.

      Fonts: font-display: swap (not optional). "optional" meant a page whose
      font missed the ~100ms window kept the fallback for that whole view,
      and the next client-side navigation then rendered in the real font:
      the text visibly changed between pages. With swap + preload the font
      is almost always ready at first paint, and when it isn't, the
      "fallback faces (local Georgia / Arial / Courier New resized to each font's
      metrics) make the swap happen without text reflowing.
      Pairing: Fraunces (display: titles and headings) + Plus Jakarta Sans
      (text) + Geist Mono (code).
    -->
    <!--
      Persisted across client-side navigations. Without this the router
      swaps in a new (identical) copy of this <style> on every page change,
      which re-creates the @font-face rules: every font goes back to
      "unloaded" and the first frame of the new page is laid out in the
      fallback faces, then re-flows a frame later. That re-flow moved text
      after it had been measured for the card ⇄ page transition (pieces
      landed a few px off and snapped; tag chips looked squeezed).
    -->
    <style is:inline data-astro-transition-persist="site-fonts" set:html={`
      @font-face {
        font-family: 'Plus Jakarta Sans';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url('${sansUrl}') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Geist Mono';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('${geistMonoUrl}') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('${displayUrl}') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Fraunces Fallback';
        src: local('Georgia'), local('Times New Roman'), local('Liberation Serif');
        size-adjust: 114.4%;
        ascent-override: 85.7%;
        descent-override: 22.7%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: 'Sans Fallback';
        src: local('Arial'), local('Liberation Sans'), local('Helvetica');
        size-adjust: 103.97%;
        ascent-override: 99.1%;
        descent-override: 22.1%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: 'Geist Mono Fallback';
        src: local('Courier New'), local('Liberation Mono'), local('Menlo');
        size-adjust: 100%;
        ascent-override: 101%;
        descent-override: 30%;
        line-gap-override: 0%;
      }
      :root {
        --color-bg: #f7f8fb;
        --color-text-primary: #0d1117;
        --header-height: 64px;
        --site-bg-color: #6aa1df; /* sky average + the 10% wash */
        --site-bg-placeholder: url('data:image/webp;base64,UklGRnwAAABXRUJQVlA4IHAAAADQBACdASoYABAAPtFUo0uoJKMhsAgBABoJagCdMoRwIr/S/4Dx/gdrmilWJamEgAD+nYNlPfMHc2H1JFVF185AnoS3/xHusgPbYjf/AUq8MBdpxa7rMk1h4qvj7zri2Si7JgrC1KqFjlvtkxhbUAAA');
        --site-bg-image: url('${baseUrl}/assets/site-bg-2560.webp');
      }
      @media (max-width: 768px) {
        :root { --site-bg-image: url('${baseUrl}/assets/site-bg-1600.webp'); }
      }
      html {
        color: #0d1117;
      }
      /*
        Two layers: the real image on top, a 24x16 inline copy of the same
        image underneath. The inline copy is part of the HTML, so the first
        paint already shows the sky instead of a flat colour; the full image
        simply sharpens it once decoded.
      */
      body {
        background-color: var(--site-bg-color);
        /* Full-opacity background image, blurred at source asset level */
        background-image:
          var(--site-bg-image),
          var(--site-bg-placeholder);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center top;
      }
    `}>
    </style>

    <!-- Astro ClientRouter: client-side navigation, no full-page reload flicker -->
    <ClientRouter fallback="none" />
  </head>
  <body id="top">
    <!-- Accessible Skip to Content Link -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <!-- Top Floating Glass Header -->
    <Header />

    <!-- Main Content Slot (Dedicated Scroll Container below Header) -->
    <main class="main-page-wrapper" id="main-content">
      <slot />
    </main>

    <!-- Global Client Search Modal -->
    <SearchModal />

    <script is:inline>
      /*
        Smooth wheel scrolling for <main> (the page's scroll container).
        Wheel/trackpad deltas are accumulated into a target and eased toward
        with a frame-rate-independent exponential; touch, keyboard and
        scrollbar dragging stay fully native. Also handles wheel over the
        floating header, which isn't inside <main>.
        Skipped for reduced motion, pinch-zoom (ctrl+wheel), horizontal
        gestures, and anything an inner scroller (menu, code block, table)
        can still consume in that direction.
      */
      (function() {
        if (window.__smoothWheel) return;
        window.__smoothWheel = true;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        var target = null, raf = 0, last = 0;
        var TAU = 90; // ms; lower = snappier

        function main() { return document.getElementById('main-content'); }

        function innerCanScroll(el, stop, dy) {
          for (; el && el !== stop && el !== document.body; el = el.parentElement) {
            var oy = getComputedStyle(el).overflowY;
            if ((oy === 'auto' || oy === 'scroll') && el.scrollHeight > el.clientHeight + 1) {
              if (dy < 0 ? el.scrollTop > 0 : el.scrollTop + el.clientHeight < el.scrollHeight - 1) return true;
            }
          }
          return false;
        }

        function stop() {
          target = null;
          if (raf) cancelAnimationFrame(raf);
          raf = 0;
        }

        function step(now) {
          var m = main();
          if (!m || target === null) return stop();
          var dt = Math.min(now - last, 64); last = now;
          var cur = m.scrollTop;
          var next = cur + (target - cur) * (1 - Math.exp(-dt / TAU));
          if (Math.abs(target - next) < 0.5) next = target;
          // behavior 'instant': main's CSS scroll-behavior is smooth (for
          // anchor links) and must not animate each frame again.
          m.scrollTo({ top: next, behavior: 'instant' });
          if (next === target) return stop();
          raf = requestAnimationFrame(step);
        }

        document.addEventListener('wheel', function(e) {
          var m = main();
          if (!m || reduce.matches || e.ctrlKey || e.defaultPrevented) return;
          if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
          var html = document.documentElement;
          if (html.classList.contains('menu-open') || html.classList.contains('modal-open')) return;
          var t = e.target;
          var inMain = m.contains(t), inHeader = t.closest && t.closest('.site-header');
          if (!inMain && !inHeader) return;
          if (inMain && innerCanScroll(t, m, e.deltaY)) return;

          var dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * m.clientHeight : e.deltaY;
          var max = m.scrollHeight - m.clientHeight;
          if (target === null) target = m.scrollTop;
          target = Math.max(0, Math.min(max, target + dy));
          e.preventDefault();
          if (!raf) { last = performance.now(); raf = requestAnimationFrame(step); }
        }, { passive: false });

        // Any other scroll input takes over immediately.
        ['keydown', 'pointerdown', 'touchstart'].forEach(function(type) {
          document.addEventListener(type, stop, { passive: true });
        });
        document.addEventListener('astro:before-swap', stop);
      })();

      /*
        Rounded scroll edge: a static clip-path on <main> shaped like the
        [data-scroll-clip] columns (same side edges and top radius), a fixed
        gap below the header, full width below the corner band so shadows
        and the scrollbar stay visible. Rebuilt only on resize / page swap.
      */
      (function() {
        var GAP = 10;
        var observer = null;

        function roundedTop(x, y, w, bottom, r) {
          return 'M' + x + ' ' + bottom + 'V' + (y + r) +
            'A' + r + ' ' + r + ' 0 0 1 ' + (x + r) + ' ' + y +
            'H' + (x + w - r) +
            'A' + r + ' ' + r + ' 0 0 1 ' + (x + w) + ' ' + (y + r) +
            'V' + bottom + 'Z';
        }

        function update() {
          var main = document.getElementById('main-content');
          if (!main) return;
          var box = main.getBoundingClientRect();
          var header = document.querySelector('.header-inner');
          var top = Math.round((header ? header.getBoundingClientRect().bottom - box.top : 0) + GAP);
          var w = Math.ceil(box.width), h = Math.ceil(box.height);
          var band = top, d = [];
          main.querySelectorAll('[data-scroll-clip]').forEach(function(el) {
            var cs = getComputedStyle(el);
            if (cs.display === 'none' || cs.position === 'fixed') return;
            var r = el.getBoundingClientRect();
            if (!r.width) return;
            var radius = parseFloat(cs.getPropertyValue('--glass-radius')) ||
              parseFloat(cs.getPropertyValue('--scroll-clip-radius')) ||
              parseFloat(cs.borderTopLeftRadius) || 0;
            band = Math.max(band, top + radius + 1);
            d.push({ x: r.left - box.left, w: r.width, r: radius });
          });
          if (!d.length) { main.style.clipPath = 'inset(' + top + 'px 0 0 0)'; return; }
          var path = d.map(function(p) { return roundedTop(p.x, top, p.w, band + 1, p.r); });
          path.push('M0 ' + band + 'H' + w + 'V' + h + 'H0Z');
          if (main.offsetWidth > main.clientWidth) {
            path.push('M' + main.clientWidth + ' ' + top + 'H' + main.offsetWidth + 'V' + h + 'H' + main.clientWidth + 'Z');
          }
          main.style.clipPath = 'path("' + path.join('') + '")';
        }

        function bind() {
          var main = document.getElementById('main-content');
          if (observer) observer.disconnect();
          if (!main || !('ResizeObserver' in window)) return update();
          observer = new ResizeObserver(update);
          observer.observe(main);
          main.querySelectorAll('[data-scroll-clip]').forEach(function(el) { observer.observe(el); });
          update();
        }

        bind();
        document.addEventListener('astro:after-swap', bind);
      })();

      /*
        Card ⇄ update page transition + scroll restoration.

        One continuous shared-element morph, run on the live DOM (the
        router's own swap is instant; see the styles below).

        Motion is transform-only (FLIP), so it runs on the compositor and
        keeps moving through the swap, and it starts on click whenever the
        destination box is known from an earlier visit (see startFlight).

        The moving shape is a single "morph" surface on <html>, outside
        <body>, so it survives the page swap. It sits at z-index -1: above
        the sky (which is the canvas background), below all page content.
        Its position, size, corner radius and fill interpolate in ONE
        animation from the source element to the destination, so the
        radius never jumps and the shape is never cut by a narrower box.

        Content is never missing:
          • The morph carries a copy of the source's visible content (with
            computed styles inlined, because the source page's CSS leaves on
            swap). The copy fades out during the first half.
          • The real destination content is uncovered by a clip-path synced
            to the morph's shape (same keyframes, same timing) and fades in
            from 20%, overlapping the copy. No frame is empty.
          • The destination hides only its own background while the morph
            stands in for it; the final morph frame matches it exactly, so
            the handover is invisible.

          open:  card (copy) → swap → grows into the update box.
          back:  update box (copy of what's on screen) → swap, list scroll
                 restored → shrinks into the same card. If that card is off
                 screen, the morph fades instead of flying to it.
      */
      (function() {
        if (window.__pageMorph) return;
        window.__pageMorph = true;

        var KEY = 'mfx-scroll:';
        var CARD_KEY = 'mfx-card:';   // a card's box in the list, saved when it opens
        var DEST_KEY = 'mfx-dest:';   // the update box, per viewport size
        var DURATION = 600;
        var EXIT = 140;
        var STEPS = 16;               // keyframe samples along the eased path
        var ease = cubicBezier(0.32, 0.72, 0, 1);
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        var nav = { type: 'push', from: '' };
        var pending = null;
        var morphEl = null;
        var flight = null;

        // Properties copied onto the content copy so it renders identically
        // after its stylesheet is gone.
        var PROPS = ['display', 'flex-direction', 'flex-wrap', 'align-items', 'justify-content', 'gap',
          'padding-top', 'padding-right', 'padding-bottom', 'padding-left',
          'margin-top', 'margin-right', 'margin-bottom', 'margin-left',
          'font-family', 'font-size', 'font-weight', 'font-style', 'line-height', 'letter-spacing',
          'font-variant-numeric', 'text-align', 'text-wrap', 'white-space', 'word-break', 'color',
          'background-color', 'border-top', 'border-right', 'border-bottom', 'border-left',
          'border-radius', 'box-shadow', 'list-style-type', 'list-style-position',
          'overflow', 'text-overflow', '-webkit-line-clamp', '-webkit-box-orient', 'opacity',
          'width', 'min-width', 'max-width', 'height', 'box-sizing', 'vertical-align'];

        // CSS cubic-bezier(), so the sampled keyframes follow the same curve.
        function cubicBezier(x1, y1, x2, y2) {
          function at(a, b, t) { return ((1 - 3 * b + 3 * a) * t + (3 * b - 6 * a)) * t * t + 3 * a * t; }
          function slope(a, b, t) { return 3 * (1 - 3 * b + 3 * a) * t * t + 2 * (3 * b - 6 * a) * t + 3 * a; }
          return function(x) {
            if (x <= 0 || x >= 1) return x <= 0 ? 0 : 1;
            var t = x;
            for (var i = 0; i < 8; i++) {
              var d = slope(x1, x2, t);
              if (Math.abs(d) < 1e-6) break;
              t -= (at(x1, x2, t) - x) / d;
            }
            if (t < 0 || t > 1 || Math.abs(at(x1, x2, t) - x) > 1e-4) {
              var lo = 0, hi = 1;
              for (var j = 0; j < 30; j++) { t = (lo + hi) / 2; if (at(x1, x2, t) < x) lo = t; else hi = t; }
            }
            return at(y1, y2, t);
          };
        }

        function main() { return document.getElementById('main-content'); }
        function edge() {
          var h = document.querySelector('.header-inner');
          return h ? h.getBoundingClientRect().bottom + 10 : 0;
        }
        function isListPath(p) { return p.replace(/\/$/, '') === (document.documentElement.dataset.base || ''); }
        // Visible part of an element (below the scroll edge). `extend`
        // lets it continue past the viewport bottom, so a morph never shows
        // rounded lower corners at the screen edge that the real element
        // (which continues off screen) doesn't have.
        function visibleRect(el, extend) {
          var r = el.getBoundingClientRect();
          var top = Math.max(r.top, edge());
          var bottom = Math.min(r.bottom, window.innerHeight + (extend || 0));
          return { x: r.left, y: top, w: r.width, h: Math.max(0, bottom - top) };
        }
        // A card's real box, cut only at the top scroll edge (where <main>'s
        // rounded clip cuts it too). Never cut at the viewport bottom: the
        // morph must end exactly where the real card is.
        function cardRect(el) {
          var r = el.getBoundingClientRect();
          var top = Math.max(r.top, edge());
          return { x: r.left, y: top, w: r.width, h: Math.max(0, r.bottom - top) };
        }
        function isVisible(el) { return visibleRect(el).h > 40; }
        function surfaceOf(el) {
          var cs = getComputedStyle(el);
          return { bg: cs.backgroundColor, radius: parseFloat(cs.borderTopLeftRadius) || 20, shadow: parseShadow(cs.boxShadow) };
        }
        function sameRect(a, b) {
          return Math.abs(a.x - b.x) < 1.5 && Math.abs(a.y - b.y) < 1.5 && Math.abs(a.w - b.w) < 1.5 && Math.abs(a.h - b.h) < 1.5;
        }

        // "rgba(..) 0px 1px 2px 0px inset, ..." → [{color, x, y, blur, spread, inset}]
        function parseShadow(s) {
          if (!s || s === 'none') return [];
          return s.split(/,(?![^(]*\))/).map(function(part) {
            var color = (part.match(/rgba?\([^)]*\)|#[0-9a-f]+/i) || ['transparent'])[0];
            var n = part.replace(color, '').match(/-?[\d.]+px/g) || [];
            n = n.map(parseFloat);
            return { color: color, x: n[0] || 0, y: n[1] || 0, blur: n[2] || 0, spread: n[3] || 0, inset: /inset/.test(part) };
          });
        }
        // The shadow as it must be written on a box scaled by (sx, sy) so it
        // renders at its true size. Blur is uniform, so it follows the
        // vertical scale: the visible part of these shadows is below the box.
        function scaledShadow(list, sx, sy) {
          if (!list.length) return 'none';
          return list.map(function(s) {
            return (s.inset ? 'inset ' : '') + (s.x / sx) + 'px ' + (s.y / sy) + 'px ' + (s.blur / sy) + 'px ' + (s.spread / sy) + 'px ' + s.color;
          }).join(', ');
        }

        function styledCopy(el) {
          var copy = el.cloneNode(true);
          (function walk(src, dst) {
            if (src.nodeType !== 1) return;
            var cs = getComputedStyle(src);
            var css = '';
            for (var k = 0; k < PROPS.length; k++) css += PROPS[k] + ':' + cs.getPropertyValue(PROPS[k]) + ';';
            // Chrome reports a line-clamped box's display as flow-root; copied
            // as is, the clamp (and its "…") is lost.
            if (cs.getPropertyValue('-webkit-line-clamp') !== 'none') css += 'display:-webkit-box;';
            dst.setAttribute('style', css);
            dst.removeAttribute('id');
            for (var n = 0; n < src.childNodes.length; n++) walk(src.childNodes[n], dst.childNodes[n]);
          })(el, copy);
          return copy;
        }
        // Copies of `blocks`, positioned where they are on screen relative
        // to rect r's top-left corner.
        function contentLayer(blocks, r) {
          var layer = document.createElement('div');
          layer.className = 'page-morph-content';
          blocks.forEach(function(b) { layer.appendChild(pinnedCopy(b, r)); });
          return layer;
        }
        function pinnedCopy(b, r) {
          var br = b.getBoundingClientRect();
          var c = styledCopy(b);
          c.style.position = 'absolute';
          c.style.left = (br.left - r.x) + 'px';
          c.style.top = (br.top - r.y) + 'px';
          c.style.width = br.width + 'px';
          c.style.margin = '0';
          return c;
        }

        function removeMorph() {
          if (morphEl) morphEl.remove();
          morphEl = null;
          flight = null;
        }

        /*
          The flight: one surface that moves from rect `from` to rect `to`.

          FLIP-style: the surface is laid out once at the destination size
          and moved with transform only (translate + scale), which the
          compositor runs by itself. So the shape keeps moving smoothly
          through the router's page swap, which blocks the main thread for
          a few frames (much longer on phones).

          Scaling would squash the corners, shadow and content, so each
          sampled keyframe carries the matching correction:
            • border-radius and box-shadow divided by the current scale;
            • the content copy counter-scaled back to true size.
          Transform and the paint corrections are separate animations, so
          the transform one stays eligible for the compositor.
        */
        function startFlight(from, to, layer, duration) {
          var W = Math.max(1, to.r.w), H = Math.max(1, to.r.h);
          if (morphEl) morphEl.remove();
          morphEl = document.createElement('div');
          morphEl.className = 'page-morph';
          morphEl.style.width = W + 'px';
          morphEl.style.height = H + 'px';
          if (layer) morphEl.appendChild(layer);
          document.documentElement.appendChild(morphEl);

          var shadow = to.surf.shadow.length ? to.surf.shadow : from.surf.shadow;
          var move = [], paint = [], counter = [];
          for (var i = 0; i <= STEPS; i++) {
            var o = i / STEPS, e = ease(o);
            var x = from.r.x + (to.r.x - from.r.x) * e;
