          html.classList.remove('vt-sheet', 'vt-sheet-open', 'vt-sheet-back');
          html.style.removeProperty('--vt-origin');
        }
        document.addEventListener('astro:before-swap', function(e) {
          if (!document.documentElement.classList.contains('vt-sheet')) return;
          if (e.viewTransition) e.viewTransition.finished.finally(endSheet);
          else endSheet();
        });

        // 1. Remember which card was clicked (only that one animates).
        document.addEventListener('click', function(e) {
          pending = null;
          var link = e.target.closest && e.target.closest('.card-link');
          if (!link || reduce.matches || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var card = link.closest('.update-card');
          if (!card) return;
          if (sheetMode()) pending = { kind: 'sheet-open', card: card };
          else if (isVisible(card)) pending = { kind: 'open', card: card };
        }, true);

        // 2. Before the swap: save scroll, start the flight right away when
        //    the destination is known, so it is already moving (on the
        //    compositor) when the swap blocks the main thread.
        document.addEventListener('astro:before-preparation', function(e) {
          // A sheet from a navigation that never reached its swap (cancelled)
          // must not leak into this one.
          endSheet();
          // e.from, not location: on back/forward the URL has already changed.
          nav.type = e.navigationType;
          nav.from = e.from.pathname;
          var m = main();
          try { if (m) sessionStorage.setItem(KEY + nav.from, String(Math.round(m.scrollTop))); } catch (err) {}

          var wrapper = document.querySelector('.doc-reading-wrapper');
          if (wrapper && isListPath(e.to.pathname) && sheetMode()) {
            pending = { kind: 'sheet-back' };
          } else if (!reduce.matches && wrapper && isListPath(e.to.pathname) && isVisible(wrapper)) {
            pending = { kind: 'back', wrapper: wrapper };
          }
          if (window.__mfxFromSearch) {
            // A search result: the search dialog covers the swap and then
            // dissolves (SearchModal), so no transition of our own.
            pending = null;
            return;
          }
          if (pending && pending.kind === 'sheet-open' && e.to.pathname.indexOf('/updates/') !== -1) {
            // The list recedes towards the tapped card; remembered so the
            // way back comes forward from the same spot.
            var cr = pending.card.getBoundingClientRect();
            var origin = Math.round(cr.left + cr.width / 2) + 'px ' + Math.round(cr.top + cr.height / 2) + 'px';
            try { sessionStorage.setItem(SHEET_ORIGIN, origin); } catch (err) {}
            startSheet('open', origin);
            return;
          }
          if (pending && pending.kind === 'sheet-back') {
            var back = null;
            try { back = sessionStorage.getItem(SHEET_ORIGIN); } catch (err) {}
            startSheet('back', back);
            return;
          }
          if (!pending || (pending.kind === 'open' && e.to.pathname.indexOf('/updates/') === -1)) {
            pending = null;
            if (!reduce.matches) plainTransition(e);
            return;
          }

          var p = pending, load = e.loader, toPath = e.to.pathname;
          e.loader = function() {
            var exit;
            if (p.kind === 'open') {
              var card = p.card;
              // Drop the pressed-state scale first: measuring a card at
              // scale(0.993) stored positions 1–2 px off for the way back.
              card.style.transition = 'none';
              card.style.transform = 'none';
              var r = card.getBoundingClientRect();
              var slug = card.dataset.updateSlug;
              var els = collectPieces(card, 1);
              p.from = { r: cardRect(card), surf: surfaceOf(card) };
              p.srcG = measurePieces(els);
              p.srcEls = els;
              // Where this card and its pieces sit in the list, for the way back.
              writeJSON(CARD_KEY + slug, {
                top: r.top + (m ? m.scrollTop : 0), x: r.left, w: r.width, h: r.height,
                bg: p.from.surf.bg, radius: p.from.surf.radius, vp: viewportKey(),
                pieces: shiftPieces(p.srcG, -r.left, -r.top)
              });
              sharedLayer();
              p.srcCopies = pieceCopies(els, p.srcG);
              card.style.visibility = 'hidden'; // surface + copies stand in for it
              var dest = readJSON(DEST_KEY + viewportKey());
              if (dest) {
                var f0 = startFlight(p.from, { r: dest.r, surf: { bg: dest.bg, radius: dest.radius, shadow: p.from.surf.shadow } }, null, DURATION);
                var destG = readJSON(PIECE_KEY + slug + '|' + viewportKey());
                if (!destG) {
                  // This update hasn't been opened at this size yet: until its
                  // page exists, the pieces ride with the box (same offset
                  // from its corner) instead of waiting behind it; they are
                  // re-aimed at their real places after the swap.
                  destG = shiftPieces(p.srcG, dest.r.x - p.from.r.x, dest.r.y - p.from.r.y);
                  p.guess = true;
                }
                p.clock = { start: f0.start, dur: DURATION };
                Object.keys(p.srcCopies).forEach(function(k) { flySource(p.srcCopies[k], p.srcG[k], destG[k] || null, p.clock, k, els[k]); });
              } else {
                startFlight(p.from, p.from, null, 1); // parked until the swap
              }
              clipShared(flight);
              var others = Array.prototype.filter.call(document.querySelectorAll('.update-card'), function(c) { return c !== card; });
              // Front-loaded: mostly gone before the surface grows over them.
              exit = Promise.all(others.map(function(c) {
                return animAt(c, [{ opacity: 1 }, { opacity: 0 }], { duration: EXIT, easing: 'cubic-bezier(0, 0, 0.2, 1)' }, 0);
              }));
            } else {
              var w = p.wrapper;
              var header = w.querySelector('.journal-hero-header');
              var pageEls = collectPieces(header, 2);
              p.from = { r: visibleRect(w, 80), surf: surfaceOf(w) };
              p.srcG = measurePieces(pageEls);
              p.srcEls = pageEls;
              var article = w.querySelector('.markdown-body');
              // Everything but the header (whose pieces fly) fades with the surface.
              var blocks = Array.prototype.slice.call(w.children).filter(function(c) { return c !== article && c !== header; })
                .concat(article ? Array.prototype.slice.call(article.children) : [])
                .filter(function(b) {
                  var br = b.getBoundingClientRect();
                  return br.bottom > p.from.r.y && br.top < window.innerHeight && br.height > 0;
                });
              var pageLayer = contentLayer(blocks, p.from.r);
              sharedLayer();
              p.srcCopies = pieceCopies(pageEls, p.srcG);
              w.style.visibility = 'hidden';
              // Predict the card's box from where it was when opened and
              // the list scroll that is about to be restored.
              var slug = (nav.from.split('/updates/')[1] || '').replace(/\/$/, '');
              var saved = readJSON(CARD_KEY + slug);
              var listScroll = null;
              try { listScroll = sessionStorage.getItem(KEY + toPath); } catch (err) {}
              var predicted = null, cardTop = 0;
              if (saved && saved.vp === viewportKey() && listScroll !== null) {
                cardTop = saved.top - Number(listScroll);
                var y = Math.max(cardTop, edge());
                if (y + 40 < window.innerHeight && cardTop + saved.h - y > 40) {
                  predicted = { x: saved.x, y: y, w: saved.w, h: cardTop + saved.h - y };
                }
              }
              if (predicted) {
                var f1 = startFlight(p.from, { r: predicted, surf: { bg: saved.bg, radius: saved.radius, shadow: p.from.surf.shadow } }, pageLayer, DURATION);
                if (saved.pieces) {
                  var cardG = shiftPieces(saved.pieces, saved.x, cardTop);
                  p.clock = { start: f1.start, dur: DURATION };
                  Object.keys(p.srcCopies).forEach(function(k) { flySource(p.srcCopies[k], p.srcG[k], cardG[k] || null, p.clock, k, pageEls[k]); });
                }
              } else {
                startFlight(p.from, p.from, pageLayer, 1);
              }
              clipShared(flight);
              fade([pageLayer], 1, 0, DURATION * 0.32);
              exit = fade([document.querySelector('.doc-sidebar')], 1, 0, EXIT);
            }
            return Promise.all([load(), exit]);
          };
        });

        // 3. After the swap (new DOM, before it is painted).
        document.addEventListener('astro:after-swap', function() {
          var path = location.pathname;
          var saved = null;
          try { saved = sessionStorage.getItem(KEY + path); } catch (err) {}
          var fromUpdate = nav.from.indexOf('/updates/') !== -1;
          // Back/forward restores position; so does returning to the list
          // from an update ("All Updates", logo). Everything else starts at top.
          var restore = saved !== null && (nav.type === 'traverse' || (fromUpdate && isListPath(path)));
          scrollMainTo(restore ? Number(saved) : 0);

          if (nav.fadeIn) {
            // Plain navigation: the new page settles in (fade + small rise).
            // <main> is the scroll container, so it only fades; a column
            // inside it may also rise.
            var region = document.querySelector(nav.fadeIn) || main();
            var rise = nav.fadeIn !== '#main-content';
            nav.fadeIn = null;
            if (region) region.animate(rise
              ? [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }]
              : [{ opacity: 0 }, { opacity: 1 }],
              { duration: FADE_IN, easing: EASE, fill: 'backwards' });
          }

          var p = pending;
          pending = null;
          if (p && p.kind.indexOf('sheet') === 0) {
            if (sheet) startSheet(sheet.kind, sheet.origin); // the view transition animates it
            return;
          }
          if (!p || !morphEl || !flight) { removeShared(); removeMorph(); return; }
          var f = flight;

          if (p.kind === 'open') {
            var wrapper = document.querySelector('.doc-reading-wrapper');
            if (!wrapper) { removeShared(); return removeMorph(); }
            var header = wrapper.querySelector('.journal-hero-header');
            var destEls = collectPieces(header, 2);
            // Reads first (geometry, styles, copies), writes after.
            var to = { r: visibleRect(wrapper, 80), surf: surfaceOf(wrapper) };
            var destG = measurePieces(destEls);
            var flow = [];
            Array.prototype.forEach.call(wrapper.children, function(c) {
              if (c === header) return;
              if (c.classList.contains('markdown-body')) Array.prototype.push.apply(flow, c.children);
              else flow.push(c);
            });
            flow = onScreen(flow);
            writeJSON(DEST_KEY + viewportKey(), { r: to.r, bg: to.surf.bg, radius: to.surf.radius });
            writeJSON(PIECE_KEY + path.split('/updates/')[1].replace(/\/$/, '') + '|' + viewportKey(), destG);
            if (!sharedEl) sharedLayer();
            var destCopies = pieceCopies(destEls, destG);

            f = f.duration === 1 ? startFlight(p.from, to, null, DURATION) : retarget(f, to);
            clipShared(f);
            var clock = p.clock, fromG = p.srcG;
            if (clock && p.guess) {
              clock = { start: performance.now(), dur: Math.max(320, p.clock.start + p.clock.dur - performance.now()) };
              fromG = retargetSources(p, destG, clock);
            }
            if (!clock) {
              clock = { start: performance.now(), dur: Math.max(360, f.start + f.duration - performance.now()) };
              Object.keys(p.srcCopies).forEach(function(k) { flySource(p.srcCopies[k], p.srcG[k], destG[k] || null, clock, k, p.srcEls[k]); });
            }
            values(destEls).forEach(function(el) { el.style.opacity = '0'; });
            Object.keys(destCopies).forEach(function(k) {
              flyDest(destCopies[k], destG[k], fromG[k] || null, clock, k, destEls[k], p.srcCopies[k]);
            });
            dropOrphans(p.srcCopies, destCopies, clock);

            var sidebar = document.querySelector('.doc-sidebar');
            if (sidebar) {
              sidebar.style.opacity = '0';
              fade([sidebar], 0, 1, DURATION * 0.6, DURATION * 0.3, elapsed(f)).then(function() { reset([sidebar]); });
            }
            reveal(f, wrapper);
            var settle = riseIn(flow, clock);
            var done = f, layer = sharedEl;
            f.done.then(function() {
              reset([wrapper]);
              if (flight === done) removeMorph();
            });
            clockDone(clock).then(function() {
              reset(values(destEls));
              if (sharedEl === layer) removeShared();
            });
            clockDone(settle).then(function() { reset(flow); });
          } else {
            var slug = (nav.from.split('/updates/')[1] || '').replace(/\/$/, '');
            var card = document.querySelector('.update-card[data-update-slug="' + slug + '"]');
            var others = Array.prototype.filter.call(document.querySelectorAll('.update-card'), function(c) { return c !== card; });
            others.forEach(function(c) { c.style.opacity = '0'; });
            fade(others, 0, 1, DURATION * 0.6, DURATION * 0.3, elapsed(f)).then(function() { reset(others); });
            if (card && isVisible(card)) {
              var cardEls = collectPieces(card, 1);
              var cto = { r: cardRect(card), surf: surfaceOf(card) };
              var cardG = measurePieces(cardEls);
              if (!sharedEl) sharedLayer();
              var cardCopies = pieceCopies(cardEls, cardG);
              f = f.duration === 1 ? startFlight(p.from, cto, f.layer, DURATION) : retarget(f, cto);
              clipShared(f);
              var clock2 = p.clock || { start: performance.now(), dur: Math.max(360, f.start + f.duration - performance.now()) };
              if (!p.clock) Object.keys(p.srcCopies).forEach(function(k) { flySource(p.srcCopies[k], p.srcG[k], cardG[k] || null, clock2, k, p.srcEls[k]); });
              // The card's slot stays empty while the surface and the copies
              // land in it; then the real card takes over with no change.
              card.style.visibility = 'hidden';
              Object.keys(cardCopies).forEach(function(k) {
                flyDest(cardCopies[k], cardG[k], p.srcG[k] || null, clock2, k, cardEls[k], p.srcCopies[k]);
              });
              dropOrphans(p.srcCopies, cardCopies, clock2);
              var landed = f, layer2 = sharedEl;
              Promise.all([f.done, clockDone(clock2)]).then(function() {
                reset([card]);
                if (sharedEl === layer2) removeShared();
                if (flight === landed) removeMorph();
              });
            } else {
              // Card is off screen: fade the surface out rather than fly to it.
              if (card) { card.style.opacity = '0'; fade([card], 0, 1, DURATION * 0.6, DURATION * 0.3).then(function() { reset([card]); }); }
              var gone = f, layer3 = sharedEl;
              fade([morphEl, sharedEl], 1, 0, DURATION * 0.6).then(function() {
                if (sharedEl === layer3) removeShared();
                if (flight === gone) removeMorph();
              });
            }
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  /*
    <main> is the page's scroll container. It spans the whole viewport (the
    header floats over it) and carries a static clip-path so content scrolls
    away under a rounded edge a fixed gap below the header (script below).
    <main> is transparent; the background is painted once, by <body>.

    No backdrop-filter anywhere on the site: inside this clipped, composited
    scroller it produced horizontal bands and scroll flicker.
  */
  .main-page-wrapper {
    position: absolute;
    inset: 0;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    /* none, not contain: stops macOS/iOS elastic bounce, which moved the
       whole page while the sticky sidebar stayed put. */
    overscroll-behavior-y: none;
    scrollbar-gutter: stable;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.35) transparent;
  }

  /* Space for the floating header. A spacer element rather than
     padding-top: sticky offsets are measured inside the scroll container's
     padding in some engines and from the scrollport edge in others, so
     padding made the sticky sidebar land in different places. */
  .main-page-wrapper::before {
    content: '';
    display: block;
    height: var(--header-offset);
  }

  .main-page-wrapper::-webkit-scrollbar {
    width: 6px;
  }

  .main-page-wrapper::-webkit-scrollbar-track {
    background: transparent;
  }

  .main-page-wrapper::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 9999px;
  }

  .main-page-wrapper::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.55);
  }
</style>

<!-- Global transition animation override -->
<style is:global>
  /*
    Page transitions.

    Astro's ClientRouter still does the fetching and DOM swap, but the swap
    itself is instant: only the root is captured (as one image of the whole
    page, blur included) and it is not animated.

    Why no named view-transition elements: the browser captures a named
    element in isolation, without the content behind it, which made
    translucent surfaces change appearance mid-transition and snap back
    (flicker), and snapshots of the full-height update page were huge to
    morph. The motion runs on the live DOM instead (script above).
  */
  ::view-transition-group(root),
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  /*
    Phones only: the update box as a sheet (see the script). Only the box
    travels; the sky behind is the same on both pages and stays still, so
    nothing overlaps. Snapshots are animated with transform/opacity only.
      open: the list cards recede and fade towards the tapped card while
            the update box rises from below the screen.
      back: the exact reverse — the box slides down and away while the
            list comes forward from the same card.
    The header is captured on its own, stays put and stays on top.
  */
  @media (max-width: 640px) {
    html.vt-sheet .site-header {
      view-transition-name: site-header;
    }
    /* The sheet is the update page's scroll area, not the box inside it: a
       captured element keeps its own clip but not its ancestors', so the
       box alone showed text that is scrolled up under the header (above
       <main>'s rounded scroll edge) over the header while it moved. <main>
       carries that clip itself and is only as big as the screen. */
    html.vt-sheet .main-page-wrapper:has(.doc-reading-wrapper) {
      view-transition-name: update-sheet;
    }
    html.vt-sheet::view-transition-group(site-header) {
      z-index: 2;
      animation: none;
    }
    html.vt-sheet::view-transition-new(site-header) {
      animation: none;
    }
    html.vt-sheet::view-transition-old(site-header) {
      display: none;
    }
    html.vt-sheet::view-transition-group(update-sheet) {
      animation: none;
    }
    html.vt-sheet::view-transition-old(root),
    html.vt-sheet::view-transition-new(root),
    html.vt-sheet::view-transition-old(update-sheet),
    html.vt-sheet::view-transition-new(update-sheet) {
      mix-blend-mode: normal;
    }

    /* Open: list (old page) above the plain new background, fading away. */
    html.vt-sheet-open::view-transition-old(root) {
      z-index: 1;
      transform-origin: var(--vt-origin, 50% 40%);
      animation: vt-list-away 460ms var(--ease-out) both;
    }
    html.vt-sheet-open::view-transition-new(root) {
      animation: none;
    }
    html.vt-sheet-open::view-transition-new(update-sheet) {
      animation: vt-sheet-up 460ms var(--ease-out) both;
    }

    /* Back: the box leaves downward; the list returns over the background. */
    html.vt-sheet-back::view-transition-old(update-sheet) {
      animation: vt-sheet-up 380ms var(--ease-out) reverse both;
    }
    html.vt-sheet-back::view-transition-old(root) {
      animation: none;
    }
    html.vt-sheet-back::view-transition-new(root) {
      transform-origin: var(--vt-origin, 50% 40%);
      animation: vt-list-away 380ms var(--ease-out) reverse both;
    }
  }

  @keyframes vt-sheet-up {
    from { transform: translateY(100vh); }
    to { transform: translateY(0); }
  }
  /* The list is gone by ~40% (the box is translucent, so text behind it
     would show through), while its recede continues to the end. */
  @keyframes vt-list-away {
    0% { transform: scale(1); opacity: 1; }
    40% { opacity: 0; }
    100% { transform: scale(0.95); opacity: 0; }
  }

  /* Shared-element morph surface (see the transition script). z-index -1
     in the root stacking context: above the canvas (sky), below all page
     content, so the real destination content is revealed on top of it. */
  .page-morph {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    transform-origin: 0 0;
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    /* No will-change: a permanently promoted layer rasterises its text
       (the card copy, tag chips) with different anti-aliasing than the real
       card, which read as a small snap at the handover. */
  }

  /* Flying copies of the shared pieces (date, title, tags…): above page
     content, below the header. */
  .page-morph-shared {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .page-morph-content {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0; /* counter-scaled against the surface (see script) */
  }
</style>
