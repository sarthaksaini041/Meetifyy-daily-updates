---
import BaseLayout from '@/layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="404 — Update Not Found | Meetifyy Daily Updates"
  description="The requested daily technical update or route was not found in the Meetifyy engineering archive."
>
  <div class="not-found-container">
    <div class="not-found-content glass">
      <div class="not-found-code">404</div>
      <div class="not-found-divider" aria-hidden="true"></div>
      <h1 class="not-found-title">Update Not Found</h1>
      <p class="not-found-desc">
        The requested date or update path does not exist in the Meetifyy engineering archive.
      </p>

      <div class="not-found-actions">
        <a href={`${baseUrl}/`} class="return-home-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Return to All Updates
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.75rem;
  }

  .not-found-content {
    max-width: 440px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    --glass-fill: var(--glass-fill-reading);
    border-radius: 20px;
    padding: 3rem 2.25rem;
  }

  .not-found-code {
    font-family: var(--font-mono);
    font-size: 5rem;
    font-weight: 700;
    color: var(--color-border-strong);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .not-found-divider {
    width: 32px;
    height: 2px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    margin: 0.25rem 0;
  }

  .not-found-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .not-found-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
    max-width: 360px;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
  }

  .return-home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-brand);
    background: var(--color-brand-light);
    border: none;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-full);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
    box-shadow: var(--shadow-subtle);
  }

  .return-home-link:hover {
    background: var(--color-brand);
    color: #ffffff;
    border-color: var(--color-brand);
    box-shadow: var(--shadow-card);
    transform: translateY(-1px);
  }

  .return-home-link:active {
    transform: translateY(0) scale(0.98);
  }
</style>
