---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UpdateCard from '@/components/UpdateCard.astro';
import { getAllUpdates, slugifyCategory, type Update } from '@/lib/updates';

/** One page per category: /tags/<category-slug>. */
export async function getStaticPaths() {
  const byCategory = new Map<string, { name: string; updates: Update[] }>();
  for (const update of await getAllUpdates()) {
    for (const name of update.categories) {
      const slug = slugifyCategory(name);
      if (!byCategory.has(slug)) byCategory.set(slug, { name, updates: [] });
      byCategory.get(slug)!.updates.push(update);
    }
  }
  return [...byCategory].map(([tag, { name, updates }]) => ({
    params: { tag },
    props: { tagName: name, updates }
  }));
}

interface Props {
  tagName: string;
  updates: Update[];
}

const { tagName, updates } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${tagName} — Updates | Meetifyy Daily Updates`}
  description={`Chronological engineering updates covering ${tagName}.`}
>
  <div class="tag-layout-container">
    <div class="tag-page-container" data-scroll-clip>
      <header class="tag-hero glass">
        <div class="tag-eyebrow">
          <a href={`${baseUrl}/`} class="breadcrumb-link">All Updates</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span class="breadcrumb-current">{tagName}</span>
        </div>
        <h1 class="tag-title">{tagName}</h1>
        <p class="tag-description">
          Daily technical updates covering {tagName}.
        </p>
        <div class="tag-meta">
          <span class="tag-count">{updates.length} update{updates.length !== 1 ? 's' : ''}</span>
        </div>
      </header>

      <section class="tag-updates-list" aria-label={`Updates tagged with ${tagName}`}>
        {updates.map((update) => <UpdateCard update={update} />)}
      </section>

      <div class="tag-page-footer">
        <a href={`${baseUrl}/`} class="return-link">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          All Updates
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tag-layout-container {
    max-width: var(--layout-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0.85rem 1.75rem 4rem;
    display: flex;
    justify-content: center;
  }

  .tag-page-container {
    width: 100%;
    max-width: 980px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    --scroll-clip-radius: 20px; /* = card radius */
  }

  /* ── Tag Hero ───────────────────────────── */
  /* Glass surface (same level as update cards) so the heading isn't set
     straight on the sky, where its muted text had almost no contrast. */
  .tag-hero {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.75rem 1.85rem;
    --glass-radius: 20px;
    border-radius: var(--glass-radius);
  }

  .tag-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .breadcrumb-link {
    color: var(--color-brand);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: var(--color-brand-hover);
  }

  .breadcrumb-sep {
    color: var(--color-border-strong);
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--color-text-muted);
  }

  .tag-title {
    font-size: 2.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.18;
    color: var(--color-text-primary);
  }

  .tag-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .tag-meta {
    display: flex;
    align-items: center;
    margin-top: 0.15rem;
  }

  .tag-count {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* ── Feed ───────────────────────────────── */
  .tag-updates-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /* ── Footer ─────────────────────────────── */
  .tag-page-footer {
    padding-top: 0.5rem;
  }

  .return-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-full);
    border: none;
    background: var(--color-surface);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
    box-shadow: var(--shadow-subtle);
  }

  @media (hover: hover) {
  .return-link:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
    box-shadow: var(--shadow-card);
  }
  }

  .return-link:active {
    transform: scale(0.98);
  }

  /* ── Responsive ─────────────────────────── */
  @media (max-width: 1024px) {
    .desktop-sidebar-only {
      display: none !important;
    }
    .tag-layout-container {
      justify-content: center;
      padding: 0.75rem 1.5rem 3.5rem;
    }
    .tag-page-container {
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .tag-layout-container {
      padding: 0.6rem 1rem 3rem;
    }
    .tag-page-container {
      gap: 0.85rem;
      --scroll-clip-radius: 16px;
          }
    .tag-hero {
      padding: 1.35rem 1.35rem;
      --glass-radius: 16px;
    }
    .tag-title {
      font-size: 1.75rem;
      text-wrap: balance;
    }
  }
</style>
