---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header" transition:persist="site-header">
  <div class="header-inner glass">
    <!-- Brand: Icon only on left side -->
    <div class="brand-group">
      <a href={`${baseUrl}/`} class="brand-link" aria-label="Daily Updates Home">
        <svg class="brand-logo-icon" width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="32" height="32" rx="10" fill="#0d1117"/>
          <path d="M16.83 6.08 C14.53 6.57 13.19 8.79 12.10 13.94 C11.78 15.44 11.70 16.03 11.70 17.05 C11.70 18.06 11.78 18.52 12.04 19.07 C12.23 19.47 12.52 19.78 12.85 19.95 C13.16 20.10 13.75 20.11 14.01 19.97 C14.39 19.77 14.69 19.49 15.27 18.80 C16.03 17.89 16.37 17.56 16.83 17.25 C18.18 16.37 19.94 16.63 20.51 17.78 C20.80 18.38 20.73 19.18 20.32 19.81 C19.94 20.41 19.11 21.06 18.38 21.34 C17.41 21.72 16.79 21.79 14.46 21.79 C12.07 21.79 11.36 21.87 10.63 22.23 C10.27 22.40 9.87 22.80 9.70 23.16 C9.23 24.15 9.56 25.21 10.47 25.67 C11.64 26.26 14.12 26.04 16.63 25.14 C20.47 23.76 23.29 21.33 23.99 18.81 C24.14 18.24 24.14 17.00 23.99 16.43 C23.66 15.25 22.88 14.27 21.86 13.77 C21.23 13.46 20.93 13.39 20.06 13.39 C19.40 13.39 19.26 13.41 18.83 13.53 C17.85 13.80 16.89 14.42 16.19 15.24 C16.00 15.45 15.56 16.05 15.23 16.57 C14.53 17.62 14.39 17.75 13.94 17.79 C13.43 17.83 13.04 17.49 13.04 16.98 C13.04 16.43 13.42 15.96 14.49 15.19 C16.41 13.80 18.21 12.09 19.04 10.85 C19.74 9.82 19.96 8.94 19.77 8.02 C19.55 6.99 18.77 6.20 17.82 6.04 C17.43 5.98 17.25 5.98 16.83 6.08 Z M9.44 17.50 C8.69 17.88 8.08 19.00 7.92 20.27 C7.83 21.05 7.97 21.59 8.37 21.95 C9.22 22.72 10.57 21.87 11.08 20.24 C11.24 19.74 11.25 18.62 11.10 18.21 C10.84 17.45 10.13 17.16 9.44 17.50 Z" fill="#FFFFFF" fill-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <!-- Right Side: Search Bar & Actions -->
    <div class="header-right">
      <button
        type="button"
        class="search-trigger-btn"
        id="open-search-btn"
        aria-label="Search updates"
        aria-keyshortcuts="Control+k Meta+k"
      >
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-text">Search updates…</span>
      </button>

      <!--
        Always rendered: the header is persisted across client-side
        navigations, so it cannot depend on per-page props. CSS shows it only
        when the current page has a sidebar.
      -->
      <button
          type="button"
          class="header-menu-btn"
          id="mobile-nav-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg class="menu-icon-bars" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
          <svg class="menu-icon-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
    </div>
  </div>
</header>

<script>
  // The header persists across navigations by being moved into the new
  // page, and a moved element's styles are recomputed without transitions.
  // So the menu button's state is a class, changed a frame after the swap:
  // the header first renders its old state, then transitions to the new one.
  function syncMenuButton(animate: boolean) {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const apply = () => {
      header.classList.add('menu-js');
      header.classList.toggle('has-menu', !!document.getElementById('doc-sidebar'));
    };
    if (animate) requestAnimationFrame(() => requestAnimationFrame(apply));
    else apply();
  }

  syncMenuButton(false);
  document.addEventListener('astro:after-swap', () => syncMenuButton(true));
</script>

<style>
  /* ── Floating Header Shell ──────────────── */
  /* Floats over <main>, which runs underneath it to the top of the viewport.
     --header-offset is the header's total height at each breakpoint. */
  :global(:root) {
    --header-offset: calc(0.55rem + 56px + 0.25rem);
  }

  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    width: 100%;
    pointer-events: none;
    padding: 0.55rem 1.5rem 0.25rem;
    background: transparent;
    isolation: isolate;
  }

  /* ── Floating Glass Capsule (Matches Update Card Material) ─ */
  .header-inner {
    --glass-fill: var(--glass-fill-chrome);
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    height: 56px;
    padding: 0 0.7rem 0 1.4rem;
    border-radius: var(--radius-full);
    gap: 1rem;
  }

  /* ── Brand (Icon Only on Left) ─────────── */
  .brand-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-link {
    display: flex;
    align-items: center;
    border-radius: 10px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .brand-link:active {
    transform: scale(0.96);
  }

  .brand-logo-icon {
    display: block;
    border-radius: 10px;
    box-shadow: 0 1px 3px rgba(13, 17, 23, 0.12);
  }

  /* ── Right Actions & Search Bar ─────────── */
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-left: auto;
  }

  .search-trigger-btn {
    width: 200px;
    height: 36px;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0 0.85rem 0 0.8rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.65);
    border: none;
    color: var(--color-text-secondary);
    font-size: 0.81rem;
    cursor: pointer;
    box-shadow:
      inset 0 1px 1px 0 rgba(13, 17, 23, 0.03),
      inset 0 -1px 0 0 rgba(255, 255, 255, 0.7);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .search-trigger-btn:active {
    transform: scale(0.985);
    background: rgba(240, 242, 247, 0.85);
  }

  .search-icon {
    flex-shrink: 0;
    color: var(--color-text-faint);
    transition: color var(--transition-fast);
  }

  .search-text {
    flex: 1;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }

  /* ── Mobile Menu Toggle Button ──────────── */
  .header-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.65);
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    box-shadow:
      inset 0 1px 1px 0 rgba(13, 17, 23, 0.02),
      inset 0 -1px 0 0 rgba(255, 255, 255, 0.7);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .header-menu-btn:active {
    transform: scale(0.95);
  }

  .header-menu-btn .menu-icon-close {
    display: none;
  }

  .header-menu-btn[aria-expanded="true"] .menu-icon-bars {
    display: none;
  }

  .header-menu-btn[aria-expanded="true"] .menu-icon-close {
    display: block;
  }

  .header-menu-btn[aria-expanded="true"] {
    background: var(--color-brand-light);
    border-color: var(--color-brand-muted);
    color: var(--color-brand);
  }

  /* ── Responsive ─────────────────────────── */
  @media (max-width: 1024px) {
    :global(:root) {
      --header-offset: calc(0.35rem + 52px);
    }
    .site-header {
      padding: 0.35rem 1rem 0;
    }
    .header-inner {
      height: 52px;
      padding: 0 0.6rem 0 1.15rem;
      gap: 0.75rem;
    }
    :global(html:has(#doc-sidebar)) .header-menu-btn {
      display: inline-flex;
    }
    .search-trigger-btn {
      width: 180px;
      height: 34px;
    }
  }

  @media (max-width: 640px) {
    :global(:root) {
      --header-offset: calc(0.3rem + 48px);
    }
    .site-header {
      padding: 0.3rem var(--mobile-gutter) 0;
    }
    .header-inner {
      height: 48px;
      padding: 0 0.45rem 0 0.95rem;
      gap: 0.5rem;
    }
    .header-right {
      flex: 1;
      justify-content: flex-end;
      gap: 0.45rem;
      min-width: 0;
    }
    /* Icon-only search button on phones */
    .search-trigger-btn {
      flex: 0 0 auto;
      width: 36px;
      height: 36px;
      padding: 0;
      justify-content: center;
    }
    .search-trigger-btn .search-icon {
      width: 16px;
      height: 16px;
      color: var(--color-text-secondary);
    }
    .search-text {
      display: none;
    }
    /*
      The menu button appears only on pages with a sidebar. Rather than
      popping in with display (which shoves the search button over in one
      frame), it is always laid out here, collapsed to zero width, and
      grows in while it fades and scales up; the search button slides
      aside with it. Same curve as the card ⇄ page transition.
    */
    .header-menu-btn {
      display: inline-flex;
      width: 0;
      height: 36px;
      flex-shrink: 0;
      margin-left: -0.45rem; /* cancels the row gap while collapsed */
      overflow: hidden;
      opacity: 0;
      transform: scale(0.6);
      visibility: hidden;
      pointer-events: none;
      transition:
        width var(--duration-slow) var(--ease-out),
        margin-left var(--duration-slow) var(--ease-out),
        transform var(--duration-slow) var(--ease-out),
        opacity var(--duration-exit) var(--ease-in),
        visibility 0s linear var(--duration-slow),
        background-color var(--transition-fast),
        color var(--transition-fast);
    }
    /* Before the script below runs, :has() decides (first paint); after
       that, the has-menu class does, so the change can be animated. */
    :global(html:has(#doc-sidebar)) .site-header:not(.menu-js) .header-menu-btn,
    .site-header.has-menu .header-menu-btn {
      width: 36px;
      margin-left: 0;
      opacity: 1;
      transform: scale(1);
      visibility: visible;
      pointer-events: auto;
      transition:
        width var(--duration-slow) var(--ease-out),
        margin-left var(--duration-slow) var(--ease-out),
        transform var(--duration-slow) var(--ease-out),
        opacity var(--duration-enter) var(--ease-out) 60ms,
        visibility 0s,
        background-color var(--transition-fast),
        color var(--transition-fast);
    }
    .site-header.has-menu .header-menu-btn:active {
      transform: scale(0.95);
    }
    @media (prefers-reduced-motion: reduce) {
      .header-menu-btn,
      .site-header.has-menu .header-menu-btn {
        transition: none;
      }
    }
  }

  @media (max-width: 360px) {
    :global(:root) {
      --header-offset: calc(0.25rem + 48px);
    }
    .site-header {
      padding: 0.25rem var(--mobile-gutter) 0;
    }
    .header-inner {
      padding: 0 0.4rem 0 0.8rem;
    }
  }
</style>
