---
import { SECTIONS } from '@/lib/sections.mjs';

// The sections worth filtering by: the ones that get their own card.
const FILTERABLE_SECTIONS = SECTIONS.filter((section) => section.callout);
---

<dialog id="search-modal" class="search-modal" aria-label="Search and filter engineering updates" transition:persist="search-modal">
  <div class="search-modal-container" id="search-modal-container">
    <!-- Top Unified Command Bar -->
    <div class="search-header-bar">
      <div class="search-input-box">
        <svg class="search-modal-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-input"
          class="search-input-field"
          placeholder="Search updates, categories, or fixes…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search updates"
        />
      </div>

      <!-- Header Controls: Filter Button -->
      <div class="search-header-actions">
        <button
          type="button"
          id="search-filter-btn"
          class="search-filter-btn"
          aria-expanded="false"
          aria-controls="search-filter-shelf"
          title="Toggle filter panel"
        >
          <svg class="filter-btn-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          <span class="filter-btn-text">Filter</span>
          <span id="filter-active-dot" class="filter-active-dot" style="display: none;" aria-hidden="true"></span>
          <span id="filter-active-badge" class="filter-active-badge" style="display: none;">0</span>
          <svg class="filter-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <button type="button" id="search-close-btn" class="search-close-btn" aria-label="Close search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Content Viewport Stage (Dedicated screen area below header) -->
    <div class="search-modal-viewport" id="search-modal-viewport">
      <!-- Full-Coverage Filter Screen (Dedicated Filter View taking 100% content area) -->
      <div id="search-filter-shelf" class="search-filter-shelf" role="region" aria-label="Filter panel">
        <!-- Single Unified Scroll Area for all filter content -->
        <div class="filter-shelf-body" id="filter-shelf-body">
          <div class="filter-shelf-inner">
            <!-- 1. Date Section Card -->
            <div class="filter-section-card">
              <div class="filter-section-header">
                <span class="filter-section-title">Date</span>
              </div>
              <div class="filter-date-pills" id="filter-date-pills" role="radiogroup" aria-label="Date range">
                <button type="button" class="date-pill active" data-date="all" role="radio" aria-checked="true">All time</button>
                <button type="button" class="date-pill" data-date="today" role="radio" aria-checked="false">Today</button>
                <button type="button" class="date-pill" data-date="week" role="radio" aria-checked="false">This week</button>
                <button type="button" class="date-pill" data-date="month" role="radio" aria-checked="false">This month</button>
                <button type="button" class="date-pill" data-date="custom" role="radio" aria-checked="false">Custom</button>
              </div>
              <div class="filter-custom-date" id="filter-custom-date" style="display: none;">
                <div class="custom-date-field">
                  <label for="filter-date-from">From</label>
                  <input type="date" id="filter-date-from" class="date-input" />
                </div>
                <div class="custom-date-field">
                  <label for="filter-date-to">To</label>
                  <input type="date" id="filter-date-to" class="date-input" />
                </div>
              </div>
            </div>

            <!-- 2. Categories Section Card -->
            <div class="filter-section-card">
              <div class="filter-section-header">
                <span class="filter-section-title">Categories</span>
                <span class="filter-section-hint">Select one or more</span>
              </div>
              <div class="filter-categories-grid" id="filter-categories-grid">
                <!-- Dynamically populated from index -->
              </div>
            </div>

            <!-- 3. Section filter (options come from src/lib/sections.mjs) -->
            <div class="filter-extras-grid">
              <div class="filter-section-card">
                <div class="filter-section-header">
                  <span class="filter-section-title">Includes Section</span>
                </div>
                <div class="filter-types-list">
                  {FILTERABLE_SECTIONS.map((section) => (
                    <label class="filter-checkbox-label">
                      <input type="checkbox" class="filter-type-cb" value={section.key} data-label={section.heading} />
                      <span class="cb-box"></span>
                      <span class="cb-label">{section.heading}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sticky Footer Action Bar -->
        <div class="filter-shelf-footer">
          <button type="button" id="filter-reset-btn" class="filter-reset-action">
            Reset filters
          </button>
          <button type="button" id="filter-done-btn" class="filter-done-action">
            Done
          </button>
        </div>
      </div>

      <!-- Results Stage: slides down and out of view when filter opens -->
      <div class="search-results-stage" id="search-results-stage">
        <!-- Active Filters Chips Bar -->
        <div id="active-filters-bar" class="active-filters-bar" style="display: none;">
          <div class="active-chips-wrapper" id="active-chips-wrapper">
            <!-- Rendered via JS -->
          </div>
          <button type="button" id="clear-all-filters-btn" class="clear-all-btn">
            Clear all
          </button>
        </div>

        <!-- Search Results Area -->
        <div class="search-results-area" id="search-results-area" role="region" aria-live="polite">
          <!-- Empty Prompt -->
          <div class="search-empty-prompt" id="search-empty-prompt" style="display: none;">
            <p class="empty-prompt-title">Browse Engineering Updates</p>
            <p class="empty-prompt-desc">Search by keyword or filter by category and date.</p>
          </div>

          <!-- Populated Results List -->
          <div class="search-results-list" id="search-results-list">
            <!-- Rendered via JS -->
          </div>

          <!-- No Results State -->
          <div class="search-no-results" id="search-no-results" style="display: none;">
            <p class="no-results-title">No updates found</p>
            <p class="no-results-hint">Try adjusting keywords or clearing active filters.</p>
            <button type="button" id="empty-clear-filters-btn" class="empty-clear-btn" style="display: none;">
              Clear filters
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  /* ─── Search Modal Dialog ─────────────────────────────── */
  .search-modal {
    position: fixed;
    top: 9%;
    left: 50%;
    transform: translate(-50%, 0);
    width: min(720px, calc(100vw - 2.5rem));
    height: min(600px, 82vh);
    max-height: min(640px, 84vh);
    padding: 0;
    border: var(--glass-border);
    border-radius: 20px;
    background: var(--glass-fill-overlay);
    box-shadow:
      0 0 0 1px rgba(15, 23, 42, 0.04),
      0 28px 72px -16px rgba(15, 23, 42, 0.2),
      0 12px 32px -6px rgba(15, 23, 42, 0.08);
    color: var(--color-text-primary);
    overflow: hidden;
    z-index: 1000;
  }

  .search-modal::backdrop {
    /* Lighter dim so the page stays perceptible behind the glass sheet. */
    background: rgba(15, 23, 42, 0.3);
  }

  .search-modal-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    background: transparent;
    overflow: hidden;
  }

  /* ─── Viewport Stage (holds sliding panels) ────────────── */
  .search-modal-viewport {
    flex: 1;
    min-height: 0;
    position: relative;
    overflow: hidden;
    width: 100%;
    background: transparent;
  }

  /* ─── Unified Command Bar Header ─────────────────────── */
  .search-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
    padding: 0 1.25rem 0 1.45rem;
    border-bottom: 1px solid rgba(226, 232, 240, 0.85);
    background: rgba(255, 255, 255, 0.35);
    z-index: 20;
    flex-shrink: 0;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: 1;
    min-width: 0;
  }

  .search-modal-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .search-modal:focus-within .search-modal-icon {
    color: var(--color-brand);
  }

  .search-input-field {
    flex: 1;
    border: none;
    outline: none;
    box-shadow: none;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-primary);
    background: transparent;
    min-width: 0;
    line-height: 1.4;
    letter-spacing: -0.015em;
    caret-color: var(--color-brand);
    -webkit-appearance: none;
    appearance: none;
  }

  .search-input-field:focus,
  .search-input-field:focus-visible {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
  }

  .search-input-field::placeholder {
    color: var(--color-text-faint);
    font-weight: 400;
    font-size: 1.02rem;
  }

  .search-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* Close button: only needed when search is full-screen (mobile). */
  .search-close-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    border: none;
    color: var(--color-text-secondary);
  }

  .search-close-btn:active {
    transform: scale(0.95);
  }

  /* ─── Refined Filter Button ───────────────────────────── */
  .search-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 34px;
    padding: 0 0.9rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    border: none;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 550;
    cursor: pointer;
    user-select: none;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .search-filter-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text-primary);
    background: #ffffff;
    box-shadow: 0 2px 5px rgba(15, 23, 42, 0.05);
  }

  .search-filter-btn[aria-expanded="true"] {
    background: var(--color-brand-light);
    border-color: var(--color-brand-muted);
    color: var(--color-brand);
  }

  .search-filter-btn.active {
    background: var(--color-brand-light);
    border-color: var(--color-brand-muted);
    color: var(--color-brand);
    font-weight: 600;
  }

  .filter-active-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand);
    flex-shrink: 0;
  }

  .filter-active-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--radius-full);
    background: var(--color-brand);
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
  }

  .filter-chevron {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
    color: currentColor;
  }

  .search-filter-btn[aria-expanded="true"] .filter-chevron {
    transform: rotate(180deg);
  }

  /* ─── Full-Coverage Filter Panel (Slides from top) ─────── */
  /* ─── Dedicated Filter Screen (Full-Coverage Takeover) ───── */
  .search-filter-shelf {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #f8fafc;
    z-index: 10;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition:
      opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-modal-container.filter-open .search-filter-shelf {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* ─── Results Stage (Completely hidden when filters are open) ─── */
  .search-results-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 5;
    background: transparent;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* When filter view is open: completely hide results so they NEVER peek through and cannot compete for scroll */
  .search-modal-container.filter-open .search-results-stage {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* ─── Single Unified Scroll Area for Filter Content ───────── */
  .filter-shelf-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .filter-shelf-body::-webkit-scrollbar {
    width: 5px;
  }

  .filter-shelf-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .filter-shelf-body::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.35);
    border-radius: 9999px;
  }

  .filter-shelf-body::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.6);
  }

  .filter-shelf-inner {
    padding: 0.95rem 1.15rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ─── Rounded Filter Section Cards ───────────────────── */
  .filter-section-card {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 12px;
    padding: 0.85rem 1.05rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.02);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .filter-section-card:hover {
    border-color: rgba(203, 213, 225, 0.95);
  }

  .filter-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .filter-section-title {
    font-size: 0.76rem;
    font-weight: 650;
    text-transform: none;
    letter-spacing: -0.01em;
    color: #334155;
    line-height: 1.2;
  }

  .filter-section-hint {
    font-size: 0.7rem;
    color: #94a3b8;
    font-weight: 400;
  }

  /* ── Date Pills ──────────────────────────────────────── */
  .filter-date-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .date-pill {
    padding: 0.3rem 0.7rem;
    border-radius: 7px;
    background: #f8fafc;
    border: 1px solid rgba(226, 232, 240, 0.85);
    color: #475569;
    font-size: 0.77rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .date-pill:hover {
    color: #0f172a;
    border-color: rgba(203, 213, 225, 0.95);
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
  }

  .date-pill.active {
    background: #eff2fe;
    border-color: #c7d2fe;
    color: #4338ca;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(67, 56, 202, 0.06);
  }

  .filter-custom-date {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.35rem;
    flex-wrap: wrap;
    border-top: 1px dashed rgba(226, 232, 240, 0.9);
    margin-top: 0.25rem;
  }

  .custom-date-field {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: #64748b;
  }

  .date-input {
    font-family: inherit;
    font-size: 0.76rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    background: #ffffff;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .date-input:focus {
    border-color: var(--color-brand);
  }

  /* ── Categories Grid: Clean 3-Column Unboxed Selectable Rows ── */
  .filter-categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.15rem 0.75rem;
    max-height: none;
    overflow-y: visible;
  }

  /* ── Unboxed Selectable Rows (Categories & Includes Section) ── */
  .filter-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.28rem 0.45rem;
    border-radius: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    user-select: none;
    font-size: 0.81rem;
    color: #334155;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .filter-checkbox-label:hover {
    background: rgba(241, 245, 249, 0.75);
    color: #0f172a;
  }

  .filter-checkbox-label:has(input[type="checkbox"]:checked) {
    background: rgba(239, 242, 254, 0.7);
    color: var(--color-brand);
    font-weight: 550;
  }

  .filter-checkbox-label input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .cb-box {
    width: 14px;
    height: 14px;
    border: 1.5px solid #cbd5e1;
    border-radius: 4px;
    background: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .filter-checkbox-label:hover .cb-box {
    border-color: #94a3b8;
  }

  .filter-checkbox-label input[type="checkbox"]:checked + .cb-box {
    background: var(--color-brand);
    border-color: var(--color-brand);
  }

  .filter-checkbox-label input[type="checkbox"]:checked + .cb-box::after {
    content: '';
    width: 3.5px;
    height: 7px;
    border: solid #ffffff;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg) translate(-0.5px, -0.5px);
  }

  .cb-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .cb-count {
    font-size: 0.68rem;
    color: #64748b;
    background: rgba(241, 245, 249, 0.95);
    padding: 0.08rem 0.45rem;
    border-radius: 9999px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .filter-checkbox-label:has(input[type="checkbox"]:checked) .cb-count {
    background: rgba(224, 231, 255, 0.9);
    color: #4338ca;
  }

  /* ── Extras Grid (Includes Section card) ─────────────────── */
  .filter-extras-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    align-items: start;
    border-top: none;
    padding-top: 0;
  }

  .filter-types-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* ── Dedicated Pinned Footer ───────────────────────────── */
  .filter-shelf-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid rgba(226, 232, 240, 0.85);
    background: rgba(255, 255, 255, 0.5);
    z-index: 20;
    flex-shrink: 0;
    box-shadow: 0 -1px 3px rgba(15, 23, 42, 0.02);
  }

  .filter-reset-action {
    font-size: 0.78rem;
    font-weight: 500;
    color: #64748b;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
  }

  .filter-reset-action:hover {
    color: var(--color-brand);
    text-decoration: underline;
  }

  .filter-done-action {
    font-size: 0.79rem;
    font-weight: 600;
    color: #ffffff;
    background: var(--color-brand);
    border: none;
    border-radius: var(--radius-full);
    padding: 0.42rem 1.35rem;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
    box-shadow: 0 2px 8px rgba(79, 103, 245, 0.28);
  }

  .filter-done-action:hover {
    background: var(--color-brand-hover);
    box-shadow: 0 4px 12px rgba(79, 103, 245, 0.35);
    transform: translateY(-0.5px);
  }

  .filter-done-action:active {
    transform: translateY(0);
  }

  /* ─── Active Filters Bar ──────────────────────────────── */
  .active-filters-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 1.45rem;
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.74rem;
    z-index: 10;
    flex-shrink: 0;
  }

  .active-chips-wrapper {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
