</style>

<script>
  // @ts-nocheck -- plain DOM script, previously inlined into every page.
  // Bundled now so browsers download and cache it once.
  (function() {
    const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
    let searchIndex = null;
    let selectedIndex = -1;

    // Filter State
    const filterState = {
      query: '',
      categories: new Set(),
      dateRange: 'all', // 'all' | 'today' | 'week' | 'month' | 'custom'
      customFrom: '',
      customTo: '',
      sections: new Set() // section keys from src/lib/sections.mjs
    };

    async function loadSearchIndex() {
      if (searchIndex) return searchIndex;
      try {
        const res = await fetch(`${baseUrl}/search-index.json`);
        if (!res.ok) throw new Error('Search index response was not ok');
        searchIndex = await res.json();
        return searchIndex;
      } catch (err) {
        console.error('Failed to load search index:', err);
        return [];
      }
    }

    function initSearch() {
      const dialog = document.getElementById('search-modal');
      const modalContainer = document.getElementById('search-modal-container');
      const input = document.getElementById('search-input');
      const openBtn = document.getElementById('open-search-btn');
      const closeBtn = document.getElementById('search-close-btn');
      const filterBtn = document.getElementById('search-filter-btn');
      const filterActiveDot = document.getElementById('filter-active-dot');
      const filterActiveBadge = document.getElementById('filter-active-badge');
      const activeFiltersBar = document.getElementById('active-filters-bar');
      const activeChipsWrapper = document.getElementById('active-chips-wrapper');
      const clearAllFiltersBtn = document.getElementById('clear-all-filters-btn');
      const categoriesGrid = document.getElementById('filter-categories-grid');
      const filterResetBtn = document.getElementById('filter-reset-btn');
      const filterDoneBtn = document.getElementById('filter-done-btn');
      const customDateContainer = document.getElementById('filter-custom-date');
      const dateFromInput = document.getElementById('filter-date-from');
      const dateToInput = document.getElementById('filter-date-to');
      const resultsList = document.getElementById('search-results-list');
      const emptyPrompt = document.getElementById('search-empty-prompt');
      const noResults = document.getElementById('search-no-results');
      const emptyClearBtn = document.getElementById('empty-clear-filters-btn');

      if (!dialog || !input) return;

      // Toggle Filter Shelf
      function toggleFilterShelf(open) {
        const isCurrentlyOpen = modalContainer ? modalContainer.classList.contains('filter-open') : false;
        const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;
        if (modalContainer) {
          modalContainer.classList.toggle('filter-open', shouldOpen);
        }
        filterBtn?.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
      }

      filterBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFilterShelf();
      });

      filterDoneBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFilterShelf(false);
      });

      filterResetBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        resetAllFilters();
      });

      clearAllFiltersBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        resetAllFilters();
      });

      emptyClearBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        resetAllFilters();
      });

      function resetAllFilters() {
        filterState.categories.clear();
        filterState.dateRange = 'all';
        filterState.customFrom = '';
        filterState.customTo = '';
        filterState.sections.clear();

        // Reset Date pills
        document.querySelectorAll('#filter-date-pills .date-pill').forEach(btn => {
          const isAll = btn.dataset.date === 'all';
          btn.classList.toggle('active', isAll);
          btn.setAttribute('aria-checked', isAll ? 'true' : 'false');
        });
        if (customDateContainer) customDateContainer.style.display = 'none';
        if (dateFromInput) dateFromInput.value = '';
        if (dateToInput) dateToInput.value = '';

        // Reset Category checkboxes
        document.querySelectorAll('.filter-cat-cb').forEach(cb => {
          cb.checked = false;
        });

        // Reset Section checkboxes
        document.querySelectorAll('.filter-type-cb').forEach(cb => {
          cb.checked = false;
        });

        updateFilterUI();
        executeSearch();
      }

      // Populate Categories dynamically
      function populateCategories(data) {
        if (!categoriesGrid || categoriesGrid.children.length > 0) return;

        // Count occurrences per category
        const catCounts = new Map();
        for (const item of data) {
          for (const cat of item.categories) {
            catCounts.set(cat, (catCounts.get(cat) || 0) + 1);
          }
        }

        // Sort descending by count, then alphabetically
        const sortedCats = Array.from(catCounts.entries()).sort((a, b) => {
          if (b[1] !== a[1]) return b[1] - a[1];
          return a[0].localeCompare(b[0]);
        });

        categoriesGrid.innerHTML = sortedCats.map(([cat, count]) => {
          return `
            <label class="filter-checkbox-label">
              <input type="checkbox" class="filter-cat-cb" value="${cat}" />
              <span class="cb-box"></span>
              <span class="cb-label" title="${cat}">${cat}</span>
              <span class="cb-count">${count}</span>
            </label>
          `;
        }).join('');

        // Wire up change events
        categoriesGrid.querySelectorAll('.filter-cat-cb').forEach(cb => {
          cb.addEventListener('change', (e) => {
            if (e.target.checked) {
              filterState.categories.add(e.target.value);
            } else {
              filterState.categories.delete(e.target.value);
            }
            updateFilterUI();
            executeSearch();
          });
        });
      }

      // Wire Date Range pills
      document.querySelectorAll('#filter-date-pills .date-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('#filter-date-pills .date-pill').forEach(p => {
            p.classList.remove('active');
            p.setAttribute('aria-checked', 'false');
          });
          pill.classList.add('active');
          pill.setAttribute('aria-checked', 'true');

          const range = pill.dataset.date;
          filterState.dateRange = range;

          if (range === 'custom') {
            customDateContainer.style.display = 'flex';
          } else {
            customDateContainer.style.display = 'none';
          }

          updateFilterUI();
          executeSearch();
        });
      });

      dateFromInput?.addEventListener('input', (e) => {
        filterState.customFrom = e.target.value;
        updateFilterUI();
        executeSearch();
      });

      dateToInput?.addEventListener('input', (e) => {
        filterState.customTo = e.target.value;
        updateFilterUI();
        executeSearch();
      });

      // Wire Section Type checkboxes
      document.querySelectorAll('.filter-type-cb').forEach(cb => {
        cb.addEventListener('change', (e) => {
          if (e.target.checked) {
            filterState.sections.add(e.target.value);
          } else {
            filterState.sections.delete(e.target.value);
          }
          updateFilterUI();
          executeSearch();
        });
      });

      // Count active filters & update UI
      function getActiveFilterCount() {
        let count = 0;
        count += filterState.categories.size;
        if (filterState.dateRange !== 'all') count += 1;
        count += filterState.sections.size;
        return count;
      }

      function updateFilterUI() {
        const count = getActiveFilterCount();

        // Update badge/dot on Filter button
        if (count > 0) {
          if (filterActiveDot) filterActiveDot.style.display = 'inline-block';
          if (filterActiveBadge) {
            filterActiveBadge.style.display = 'inline-flex';
            filterActiveBadge.textContent = String(count);
          }
          filterBtn.classList.add('active');
        } else {
          if (filterActiveDot) filterActiveDot.style.display = 'none';
          if (filterActiveBadge) filterActiveBadge.style.display = 'none';
          filterBtn.classList.remove('active');
        }

        // Render Active Chips bar
        if (count > 0) {
          activeFiltersBar.style.display = 'flex';
          const chips = [];

          // Categories chips
          for (const cat of filterState.categories) {
            chips.push(`
              <span class="filter-chip">
                <span>${cat}</span>
                <span class="filter-chip-remove" data-remove-type="category" data-remove-val="${cat}" role="button" aria-label="Remove ${cat} filter">×</span>
              </span>
            `);
          }

          // Date chip
          if (filterState.dateRange !== 'all') {
            let label = 'Date: ' + filterState.dateRange;
            if (filterState.dateRange === 'today') label = 'Today';
            else if (filterState.dateRange === 'week') label = 'This week';
            else if (filterState.dateRange === 'month') label = 'This month';
            else if (filterState.dateRange === 'custom') {
              const from = filterState.customFrom || 'Start';
              const to = filterState.customTo || 'End';
              label = `${from} → ${to}`;
            }
            chips.push(`
              <span class="filter-chip">
                <span>${label}</span>
                <span class="filter-chip-remove" data-remove-type="date" role="button" aria-label="Remove date filter">×</span>
              </span>
            `);
          }

          // Section chips
          for (const sec of filterState.sections) {
            const label = document.querySelector(`.filter-type-cb[value="${sec}"]`)?.dataset.label || sec;
            chips.push(`
              <span class="filter-chip">
                <span>${label}</span>
                <span class="filter-chip-remove" data-remove-type="section" data-remove-val="${sec}" role="button" aria-label="Remove ${sec} filter">×</span>
              </span>
            `);
          }

          activeChipsWrapper.innerHTML = chips.join('');

          // Wire chip dismiss buttons
          activeChipsWrapper.querySelectorAll('.filter-chip-remove').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const type = btn.dataset.removeType;
              const val = btn.dataset.removeVal;

              if (type === 'category') {
                filterState.categories.delete(val);
                const cb = categoriesGrid?.querySelector(`input[value="${val}"]`);
                if (cb) cb.checked = false;
              } else if (type === 'date') {
                filterState.dateRange = 'all';
                filterState.customFrom = '';
                filterState.customTo = '';
                document.querySelectorAll('#filter-date-pills .date-pill').forEach(p => {
                  const isAll = p.dataset.date === 'all';
                  p.classList.toggle('active', isAll);
                  p.setAttribute('aria-checked', isAll ? 'true' : 'false');
                });
                if (customDateContainer) customDateContainer.style.display = 'none';
                if (dateFromInput) dateFromInput.value = '';
                if (dateToInput) dateToInput.value = '';
              } else if (type === 'section') {
                filterState.sections.delete(val);
                const cb = document.querySelector(`.filter-type-cb[value="${val}"]`);
                if (cb) cb.checked = false;
              }

              updateFilterUI();
              executeSearch();
            });
          });
        } else {
          activeFiltersBar.style.display = 'none';
          activeChipsWrapper.innerHTML = '';
        }
      }

      async function openModal() {
        if (dialog.open) return;
        // The long placeholder is truncated on narrow screens.
        input.placeholder = window.matchMedia('(max-width: 640px)').matches
          ? 'Search updates…'
          : 'Search updates, categories, or fixes…';
        document.documentElement.classList.add('modal-open');
        dialog.showModal();
        const data = await loadSearchIndex();
        populateCategories(data);
        input.value = filterState.query;
        updateFilterUI();
        executeSearch();
        setTimeout(() => input.focus(), 50);
      }

      function closeModal() {
        dialog.close();
        document.documentElement.classList.remove('modal-open');
        toggleFilterShelf(false);
        // Return focus to the trigger when the browser didn't restore it.
        if (document.activeElement === document.body) {
          openBtn?.focus({ preventScroll: true });
        }
      }

      openBtn?.addEventListener('click', openModal);
      closeBtn?.addEventListener('click', closeModal);

      // Clean removal of modal-open on native close event
      dialog.addEventListener('close', () => {
        document.documentElement.classList.remove('modal-open');
        toggleFilterShelf(false);
      });

      // Light-dismiss when clicking backdrop
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX && e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          closeModal();
        }
      });

      // Keyboard shortcuts: Cmd+K / Ctrl+K / '/'
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (dialog.open) {
            closeModal();
          } else {
            openModal();
          }
        }
        if (e.key === '/' && !dialog.open && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
          e.preventDefault();
          openModal();
        }
      });

      // Escape key handles closing filter shelf first if open
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (modalContainer && modalContainer.classList.contains('filter-open')) {
            e.preventDefault();
            e.stopPropagation();
            toggleFilterShelf(false);
          } else {
            // Handle it ourselves: in a type="search" input, the browser's
            // default for Escape is to clear the text, so the dialog would
            // otherwise need two presses to close.
            e.preventDefault();
            closeModal();
          }
        }
      });

      // Search input changes
      input.addEventListener('input', (e) => {
        filterState.query = e.target.value.trim();
        executeSearch();
      });

      // Result navigation with keyboard
      input.addEventListener('keydown', (e) => {
        const items = resultsList.querySelectorAll('.search-result-item');
        if (items.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = (selectedIndex + 1) % items.length;
          updateSelection(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = (selectedIndex - 1 + items.length) % items.length;
          updateSelection(items);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (selectedIndex >= 0 && selectedIndex < items.length) {
            items[selectedIndex].click();
          } else if (input.value.trim()) {
            items[0].click();
          }
        }
      });

      function updateSelection(items) {
        items.forEach((item, idx) => {
          if (idx === selectedIndex) {
            item.classList.add('selected');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('selected');
          }
        });
      }

      function highlightText(text, tokens) {
        if (!text) return '';
        if (!tokens || tokens.length === 0) return text;
        const escaped = tokens.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
        const regex = new RegExp(`(${escaped})`, 'gi');
        return text.replace(regex, '<mark class="search-highlight">$1</mark>');
      }

      // Date filter. Compares ISO dates (YYYY-MM-DD) as strings, in local time.
      function isoDay(d) {
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      }
      function matchesDateFilter(item) {
        const range = filterState.dateRange;
        if (range === 'all') return true;
        const today = new Date();
        if (range === 'today') return item.isoDate === isoDay(today);
        if (range === 'week') {
          const weekAgo = new Date(today);
          weekAgo.setDate(today.getDate() - 6);
          return item.isoDate >= isoDay(weekAgo) && item.isoDate <= isoDay(today);
        }
        if (range === 'month') return item.isoDate.slice(0, 7) === isoDay(today).slice(0, 7);
        if (range === 'custom') {
          if (filterState.customFrom && item.isoDate < filterState.customFrom) return false;
          if (filterState.customTo && item.isoDate > filterState.customTo) return false;
        }
        return true;
      }

      async function executeSearch() {
        selectedIndex = -1;
        const data = await loadSearchIndex();
        if (!data || data.length === 0) return;

        const query = filterState.query;
        const activeFilterCount = getActiveFilterCount();
        const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);

        // Filter updates
        const filtered = data.filter((item) => {
          // 1. Text Query Filter
          if (tokens.length > 0) {
            const searchable = [
              item.title,
              item.summary,
              item.fullDate,
              item.shortDate,
              ...item.categories,
              item.content
            ].join(' ').toLowerCase();

            const matchesTokens = tokens.every(token => searchable.includes(token));
            if (!matchesTokens) return false;
          }

          // 2. Category Filter (Union / OR rule)
          if (filterState.categories.size > 0) {
            const hasAnyCategory = Array.from(filterState.categories).some(cat => item.categories.includes(cat));
            if (!hasAnyCategory) return false;
          }

          // 3. Date Filter
          if (!matchesDateFilter(item)) return false;

          // 4. Section Type Filter (AND: item must contain all checked sections)
          if (filterState.sections.size > 0) {
            for (const sec of filterState.sections) {
              if (!item.sections.includes(sec)) return false;
            }
          }

          return true;
        });

        // UI Rendering
        if (filtered.length === 0) {
          emptyPrompt.style.display = 'none';
          noResults.style.display = 'flex';
          emptyClearBtn.style.display = activeFilterCount > 0 ? 'inline-block' : 'none';
          resultsList.innerHTML = '';
          return;
        }

        noResults.style.display = 'none';
        emptyPrompt.style.display = 'none';

        resultsList.innerHTML = filtered.map((item, idx) => {
          const highlightedTitle = highlightText(item.title, tokens);

          // Snippet: a matching named fix if the query hits one, else the summary.
          let snippetText = item.summary;
          if (tokens.length > 0) {
            const matchingFix = item.fixes.find(fix => tokens.some(t => fix.toLowerCase().includes(t)));
            if (matchingFix) snippetText = `Fix: ${matchingFix} — ${item.summary}`;
          }

          const highlightedSnippet = highlightText(snippetText, tokens);

          // Fixed category presentation: separate badge capsules with clean spacing
          const tagsHtml = item.categories.slice(0, 3).map(cat => `<span class="result-tag-badge">${cat}</span>`).join('');
          const commitBadge = `<span class="result-commits">${item.commitCount} commits</span>`;

          return `
            <a href="${baseUrl}/updates/${item.slug}" class="search-result-item">
              <div class="result-meta-row">
                <span class="result-date">${item.fullDate}</span>
                ${tagsHtml ? `<div class="result-tags-wrap">${tagsHtml}</div>` : ''}
                ${commitBadge}
              </div>
              <div class="result-title">${highlightedTitle}</div>
              <div class="result-snippet">${highlightedSnippet}</div>
            </a>
          `;
        }).join('');

        // Nothing is pre-highlighted; arrow keys start the selection.
        selectedIndex = -1;
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch);
    } else {
      initSearch();
    }
  })();
</script>
